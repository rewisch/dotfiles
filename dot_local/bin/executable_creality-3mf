#!/usr/bin/env python3
"""Build a Creality Print project 3MF (and optionally G-code) from STL/3MF geometry.

Creality Print's CLI can slice but no longer exports project files, so this
writes one directly: geometry in 3D/3dmodel.model, the presets resolved by a
CLI test slice in Metadata/project_settings.config, and a plate description in
Metadata/model_settings.config (without it the slicer rejects the file with
"Filament nozzle mapping is incomplete").

usage: creality-3mf -o out.3mf [--gcode] [-p PRINTER] [-s PROCESS] [-f FILAMENT]\n                    [--set KEY=VALUE ...] model.stl|model.3mf ...

Inputs: binary/ASCII STL, or a plain geometry 3MF (e.g. a SolidCraft export; all
objects are placed on plate 1 with extruder 1). Preset names are the JSON
basenames under /opt/creality-print/resources/profiles/Creality/{machine,process,filament}.
--gcode also writes <out>.gcode next to the project and prints the estimate.
"""
import argparse, glob, json, os, re, shutil, struct, subprocess, sys, tempfile, zipfile
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape

PROFILES = "/opt/creality-print/resources/profiles/Creality"
APP_VERSION = "7.3.0.6157"   # the installed Creality Print; marks the file as its own project
PROFILE_VERSION = "26.10.10.09"
NS = {"m": "http://schemas.microsoft.com/3dmanufacturing/core/2015/02"}

def read_stl(path):
    data = open(path, "rb").read(); tris = []
    if len(data) >= 84 and len(data) == 84 + 50 * struct.unpack("<I", data[80:84])[0]:
        for i in range(struct.unpack("<I", data[80:84])[0]):
            v = struct.unpack("<12f", data[84 + 50 * i:84 + 50 * i + 48])
            tris.append((v[3:6], v[6:9], v[9:12]))
    else:
        cur = []
        for line in data.decode("ascii", "replace").splitlines():
            t = line.split()
            if t[:1] == ["vertex"]:
                cur.append(tuple(float(x) for x in t[1:4]))
                if len(cur) == 3: tris.append(tuple(cur)); cur = []
    return [(os.path.splitext(os.path.basename(path))[0], tris)]

def read_3mf(path):
    """Meshes of a plain 3MF: build items -> objects with a <mesh> (component
    trees are flattened one level), item/component transforms applied."""
    root = ET.fromstring(zipfile.ZipFile(path).read("3D/3dmodel.model"))
    objs = {o.get("id"): o for o in root.find("m:resources", NS).findall("m:object", NS)}
    def mat(s):
        if not s: return None
        m = [float(x) for x in s.split()]
        return m if len(m) == 12 else None
    def apply(m, v):
        if m is None: return v
        x, y, z = v
        return (m[0]*x + m[3]*y + m[6]*z + m[9], m[1]*x + m[4]*y + m[7]*z + m[10], m[2]*x + m[5]*y + m[8]*z + m[11])
    def mesh_of(o, m):
        mesh = o.find("m:mesh", NS)
        if mesh is None:
            tris = []
            comps = o.find("m:components", NS)
            for c in (comps.findall("m:component", NS) if comps is not None else []):
                tris += mesh_of(objs[c.get("objectid")], mat(c.get("transform")))
            return [tuple(apply(m, v) for v in t) for t in tris]
        verts = [(float(v.get("x")), float(v.get("y")), float(v.get("z"))) for v in mesh.find("m:vertices", NS)]
        return [tuple(apply(m, verts[int(t.get(k))]) for k in ("v1", "v2", "v3")) for t in mesh.find("m:triangles", NS)]
    out = []
    for n, item in enumerate(root.find("m:build", NS).findall("m:item", NS), start=1):
        o = objs[item.get("objectid")]
        name = o.get("name") or f"{os.path.splitext(os.path.basename(path))[0]}_{n}"
        out.append((name, mesh_of(o, mat(item.get("transform")))))
    return out

BED = (220.0, 220.0)   # Creality K1C
GAP = 8.0

def place_on_bed(meshes):
    """A project file saved by Creality Print keeps its object positions, so the
    slicer no longer arranges them: put every object on Z=0 and lay them out in
    a row, centred on the bed (the SolidCraft exports are centred on the origin)."""
    boxes = []
    for name, tris in meshes:
        xs = [v[0] for t in tris for v in t]; ys = [v[1] for t in tris for v in t]; zs = [v[2] for t in tris for v in t]
        boxes.append((min(xs), max(xs), min(ys), max(ys), min(zs)))
    total_w = sum(b[1] - b[0] for b in boxes) + GAP * (len(boxes) - 1)
    x = BED[0] / 2 - total_w / 2
    out = []
    for (name, tris), (x0, x1, y0, y1, z0) in zip(meshes, boxes):
        dx = x - x0; dy = BED[1] / 2 - (y0 + y1) / 2; dz = -z0
        out.append((name, [tuple((v[0] + dx, v[1] + dy, v[2] + dz) for v in t) for t in tris]))
        x += (x1 - x0) + GAP
    if total_w > BED[0] or any(b[3] - b[2] > BED[1] for b in boxes):
        print(f"warning: objects span {total_w:.0f} mm in X, bed is {BED[0]:.0f} x {BED[1]:.0f} mm", file=sys.stderr)
    return out

def write_stl(path, meshes):
    with open(path, "wb") as o:
        n = sum(len(t) for _, t in meshes)
        o.write(b"\0" * 80 + struct.pack("<I", n))
        for _, tris in meshes:
            for tri in tris:
                o.write(struct.pack("<3f", 0, 0, 0) + b"".join(struct.pack("<3f", *v) for v in tri) + b"\0\0")

def model_xml(meshes):
    objs = []; items = []
    for oid, (name, tris) in enumerate(meshes, start=1):
        verts = {}; order = []; faces = []
        for tri in tris:
            idx = []
            for v in tri:
                if v not in verts: verts[v] = len(order); order.append(v)
                idx.append(verts[v])
            faces.append(idx)
        vs = "".join(f'<vertex x="{v[0]:.6f}" y="{v[1]:.6f}" z="{v[2]:.6f}"/>' for v in order)
        fs = "".join(f'<triangle v1="{a}" v2="{b}" v3="{c}"/>' for a, b, c in faces)
        objs.append(f'<object id="{oid}" name="{escape(name)}" type="model"><mesh><vertices>{vs}</vertices><triangles>{fs}</triangles></mesh></object>')
        items.append(f'<item objectid="{oid}" printable="1"/>')
    return ('<?xml version="1.0" encoding="UTF-8"?>\n'
            '<model unit="millimeter" xml:lang="en-US" xmlns="http://schemas.microsoft.com/3dmanufacturing/core/2015/02">'
            f'<metadata name="Application">Creality_Print V{APP_VERSION} Release</metadata>'
            '<metadata name="BambuStudio:3mfVersion">1</metadata>'
            f'<resources>{"".join(objs)}</resources><build>{"".join(items)}</build></model>')

def model_settings_xml(meshes):
    objs = []; inst = []
    for oid, (name, _) in enumerate(meshes, start=1):
        objs.append(f'  <object id="{oid}">\n    <metadata key="name" value="{escape(name)}"/>\n'
                    f'    <metadata key="extruder" value="1"/>\n  </object>')
        inst.append(f'    <model_instance>\n      <metadata key="object_id" value="{oid}"/>\n'
                    f'      <metadata key="instance_id" value="0"/>\n    </model_instance>')
    return ('<?xml version="1.0" encoding="UTF-8"?>\n<config>\n' + "\n".join(objs) + '\n  <plate>\n'
            '    <metadata key="plater_id" value="1"/>\n    <metadata key="plater_name" value=""/>\n'
            '    <metadata key="locked" value="false"/>\n' + "\n".join(inst) + '\n  </plate>\n</config>\n')

META = {"type", "name", "inherits", "from", "instantiation", "setting_id", "filament_id",
        "printer_model", "printer_variant", "is_custom_defined", "version", "description",
        "renamed_from", "alias", "upward_compatible_machine", "default_materials", "family",
        "model_id"}  # compatible_printers* stay: the CLI checks them against the machine

def process_json(a, outdir):
    """The process preset to load: the stock file, or (with --set) a flat copy
    with the inherits chain resolved and the overrides applied."""
    stock = f"{PROFILES}/process/{a.process}.json"
    if not a.set:
        return stock
    chain = []; name = a.process
    while name:
        j = json.load(open(f"{PROFILES}/process/{name}.json")); chain.append(j); name = j.get("inherits")
    cfg = {}
    for j in reversed(chain): cfg.update(j)
    cfg = {k: v for k, v in cfg.items() if k not in META}
    for kv in a.set:
        if "=" not in kv: sys.exit(f"--set expects key=value, got {kv!r}")
        k, v = kv.split("=", 1)
        if k not in cfg: sys.exit(f"--set: {k!r} is not a process setting (see the keys in {stock} and its parents)")
        cfg[k] = [v] if isinstance(cfg[k], list) else v
    cfg.update({"type": "process", "name": a.process + " (modified)", "from": "User", "instantiation": "true"})
    p = os.path.join(outdir, "process.json"); json.dump(cfg, open(p, "w"), indent=2); return p

def creality_config_xml():
    """The marker Creality Print writes itself; without it the GUI treats the
    file as foreign and asks for the printer preset."""
    import datetime
    items = [("Company", "Creality"), ("Application", "Creality_Print"), ("AppVersion", APP_VERSION),
             ("AppStage", "Release"), ("FileVersion", "1.0"), ("FileType", "Undefined"),
             ("ProfileVersion", PROFILE_VERSION),
             ("CreationDate", datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S"))]
    return ('<?xml version="1.0" encoding="UTF-8"?>\n<config>\n' +
            "".join(f'    <metadata key="{k}" value="{escape(v)}"/>\n' for k, v in items) + '</config>\n')

def ask_filament(printer):
    """The loaded spool changes from print to print, so it is never assumed:
    ask in a terminal, refuse otherwise (an agent must ask the owner first)."""
    suffix = " @" + printer
    names = sorted(f[:-len(".json")] for f in os.listdir(f"{PROFILES}/filament")
                   if f.endswith(suffix + ".json"))
    if not sys.stdin.isatty():
        sys.exit("no filament given: pass -f \"<name>\" (ask the owner which spool is loaded).\n"
                 "Presets for this printer:\n  " + "\n  ".join(names))
    print(f"Which filament is loaded? (presets for {printer})")
    for i, n in enumerate(names, start=1):
        print(f"  {i:2d}) {n[:-len(suffix)]}")
    while True:
        try:
            ans = input("number or name: ").strip()
        except EOFError:
            sys.exit("\nno filament chosen")
        if ans.isdigit() and 1 <= int(ans) <= len(names):
            return names[int(ans) - 1]
        for n in names:
            if ans.lower() in (n.lower(), n[:-len(suffix)].lower()):
                return n
        print("not a preset, try again")

def cli_slice(a, stl, outdir):
    """Slice via the Creality Print CLI; returns the plate G-code path."""
    cmd = ["creality-print", "--cli",
           "--load-settings", f"{PROFILES}/machine/{a.printer}.json;{process_json(a, outdir)}",
           "--load-filaments", f"{PROFILES}/filament/{a.filament}.json",
           "--slice", "0", "--need-gcode-file", "--outputdir", outdir, stl]
    env = dict(os.environ); env.pop("DISPLAY", None); env.pop("WAYLAND_DISPLAY", None)
    r = subprocess.run(cmd, env=env, capture_output=True, text=True)
    g = glob.glob(f"{outdir}/plate_*.gcode")
    if r.returncode or not g:
        errs = [l for l in r.stdout.splitlines() if "[error]" in l and "main " not in l and "breakpad" not in l]
        sys.exit("slicing failed (exit %d):\n%s" % (r.returncode, "\n".join(errs[-8:])))
    return g[0]

def config_from_gcode(path):
    txt = open(path, errors="replace").read()
    blk = txt[txt.find("; CONFIG_BLOCK_START"):txt.find("; CONFIG_BLOCK_END")]
    cfg = {}
    for line in blk.splitlines():
        m = re.match(r"^; ([a-z0-9_]+) = (.*)$", line)
        if m: cfg[m.group(1)] = m.group(2)
    return cfg

def estimate(path):
    txt = open(path, errors="replace").read()
    t = re.search(r"; estimated printing time \(normal mode\) = (.*)", txt)
    f = re.search(r"; total filament used \[g\] = (.*)", txt)
    h = re.search(r"; max_z_height: (.*)", txt)
    return (t and t.group(1).strip(), f and f.group(1).strip(), h and h.group(1).strip())

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-o", "--output", required=True, help="project .3mf to write")
    ap.add_argument("--gcode", action="store_true", help="also write <output>.gcode and print the estimate")
    ap.add_argument("-p", "--printer", default="Creality K1C 0.4 nozzle")
    ap.add_argument("-s", "--process", default="0.20mm Standard @Creality K1C 0.4 nozzle")
    ap.add_argument("-f", "--filament", help="filament preset; asked interactively when omitted in a terminal")
    ap.add_argument("--set", action="append", default=[], metavar="KEY=VALUE",
                    help="override a process setting, e.g. --set enable_support=1 --set sparse_infill_density=30%%")
    ap.add_argument("model", nargs="+", help=".stl or plain geometry .3mf")
    a = ap.parse_args()
    if not a.filament:
        a.filament = ask_filament(a.printer)
    for k, kind in (("printer", "machine"), ("process", "process"), ("filament", "filament")):
        if not os.path.exists(f"{PROFILES}/{kind}/{getattr(a, k)}.json"):
            sys.exit(f"{k} preset not found: {PROFILES}/{kind}/{getattr(a, k)}.json")

    meshes = []
    for p in a.model:
        meshes += read_3mf(p) if p.lower().endswith(".3mf") else read_stl(p)
    for n, t in meshes:
        if not t: sys.exit(f"no triangles read for object {n!r}")
    meshes = place_on_bed(meshes)

    with tempfile.TemporaryDirectory() as tmp:
        stl = os.path.join(tmp, "all.stl"); write_stl(stl, meshes)
        gcode = cli_slice(a, stl, tmp)
        cfg = config_from_gcode(gcode)
        cfg["printer_settings_id"] = a.printer
        cfg["print_settings_id"] = a.process
        cfg["filament_settings_id"] = [a.filament]
        with zipfile.ZipFile(a.output, "w", zipfile.ZIP_DEFLATED) as z:
            z.writestr("[Content_Types].xml",
                '<?xml version="1.0" encoding="UTF-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
                '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
                '<Default Extension="model" ContentType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml"/></Types>')
            z.writestr("_rels/.rels",
                '<?xml version="1.0" encoding="UTF-8"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                '<Relationship Target="/3D/3dmodel.model" Id="rel-1" Type="http://schemas.microsoft.com/3dmanufacturing/2013/01/3dmodel"/></Relationships>')
            z.writestr("3D/3dmodel.model", model_xml(meshes))
            z.writestr("Metadata/project_settings.config", json.dumps(cfg, indent=4, ensure_ascii=False))
            z.writestr("Metadata/model_settings.config", model_settings_xml(meshes))
            z.writestr("Metadata/creality.config", creality_config_xml())
        print(f"wrote {a.output}: {len(meshes)} object(s) [{', '.join(n for n, _ in meshes)}]")
        print(f"  printer={a.printer!r} process={a.process!r} filament={a.filament!r}")
        if a.set: print("  overrides: " + ", ".join(a.set))
        t, f, h = estimate(gcode)
        print(f"  estimate: {t or '?'}, {f or '?'} g filament, {h or '?'} mm high")
        if a.gcode:
            gp = os.path.splitext(a.output)[0] + ".gcode"; shutil.copyfile(gcode, gp); print(f"wrote {gp}")

if __name__ == "__main__":
    main()
