#!/usr/bin/env bash
# homeca - tiny private CA for the home network (*.home.arpa, 192.168.0.0/16)
#
#   homeca init                         create the root CA (once)
#   homeca issue <name> <san> [san...]  issue/renew a server cert (825 days)
#   homeca list                         show issued certs, expiry and days left
#
# Full guide (what is deployed where, how to renew): ~/.local/share/homeca/RENEWAL.md
#
# CA key + issued certs live in ~/.secrets/homeca (dir 700). The CA key is kept
# encrypted in chezmoi; the public CA cert is installed on clients by chezmoi
# (see run_onchange_after_install-homeca-root.sh).
set -euo pipefail

DIR="${HOMECA_DIR:-$HOME/.secrets/homeca}"
CA_KEY="$DIR/ca.key"
CA_CRT="$DIR/ca.crt"
CA_NAME="Homeworld Root CA"
CA_DAYS=7305        # 20 years
LEAF_DAYS=825       # max that Apple/Android accept for TLS server certs

die() { echo "homeca: $*" >&2; exit 1; }

cmd_init() {
  [[ -e $CA_KEY ]] && die "CA already exists in $DIR"
  install -d -m 700 "$DIR" "$DIR/issued"
  umask 077
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out "$CA_KEY"
  openssl req -x509 -new -key "$CA_KEY" -sha256 -days "$CA_DAYS" \
    -subj "/O=Homeworld/CN=$CA_NAME" -out "$CA_CRT" \
    -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
    -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -addext "subjectKeyIdentifier=hash" \
    -addext "nameConstraints=critical,permitted;DNS:home.arpa,permitted;DNS:.home.arpa,permitted;IP:192.168.0.0/255.255.0.0"
  chmod 644 "$CA_CRT"
  echo "created $CA_CRT"
  openssl x509 -in "$CA_CRT" -noout -subject -enddate -fingerprint -sha256
}

cmd_issue() {
  [[ $# -ge 2 ]] || die "usage: homeca issue <name> <san> [san...]"
  [[ -r $CA_KEY ]] || die "no CA key in $DIR (run 'homeca init' or chezmoi apply)"
  local name=$1; shift
  local san="" s
  for s in "$@"; do
    if [[ $s =~ ^[0-9.]+$ ]]; then san+="IP:$s,"; else san+="DNS:${s,,},"; fi
  done
  san=${san%,}
  local out="$DIR/issued/$name"
  install -d -m 700 "$out"
  umask 077
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$out/key.pem"
  openssl req -new -key "$out/key.pem" -subj "/O=Homeworld/CN=${1,,}" -out "$out/csr.pem"
  openssl x509 -req -in "$out/csr.pem" -CA "$CA_CRT" -CAkey "$CA_KEY" -CAcreateserial \
    -days "$LEAF_DAYS" -sha256 -out "$out/cert.pem" -extfile <(printf '%s\n' \
      "basicConstraints=critical,CA:FALSE" \
      "keyUsage=critical,digitalSignature,keyEncipherment" \
      "extendedKeyUsage=serverAuth" \
      "subjectKeyIdentifier=hash" \
      "authorityKeyIdentifier=keyid" \
      "subjectAltName=$san")
  cat "$out/cert.pem" "$CA_CRT" > "$out/fullchain.pem"
  rm -f "$out/csr.pem"
  openssl verify -CAfile "$CA_CRT" "$out/cert.pem" >/dev/null || die "verification failed"
  echo "issued $name -> $out/{cert,key,fullchain}.pem"
  openssl x509 -in "$out/cert.pem" -noout -enddate -ext subjectAltName | sed 's/^/  /'
}

cmd_list() {
  local c end days warn=0
  for c in "$CA_CRT" "$DIR"/issued/*/cert.pem; do
    [[ -e $c ]] || continue
    end=$(openssl x509 -in "$c" -noout -enddate | cut -d= -f2)
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf '%-16s %-26s %5d days%s\n' \
      "$([[ $c == "$CA_CRT" ]] && echo "ROOT CA" || basename "$(dirname "$c")")" \
      "$end" "$days" "$( (( days < 45 )) && echo '  <-- RENEW' )"
    (( days < 45 )) && warn=1
  done
  (( warn )) && echo "Renewal steps: ~/.local/share/homeca/RENEWAL.md"
  return 0
}

case "${1:-}" in
  init)  cmd_init ;;
  issue) shift; cmd_issue "$@" ;;
  list)  cmd_list ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
