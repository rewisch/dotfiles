#!/usr/bin/env -S python3 -I
"""Silence watcher for npu-dictate.

Follows the growing WAV that pw-record writes (16 kHz mono s16) and ends the
dictation by itself:
  - after speech, SILENCE_SEC seconds without voice  -> `npu-dictate stop` (transcribe)
  - no voice at all within NOSPEECH_SEC seconds       -> `npu-dictate cancel`
  - MAX_SEC reached                                   -> `npu-dictate stop`
Exits quietly once the recording ends some other way (SUPER+D).

Usage: npu-dictate-vad <wav> <pidfile> <silence_sec> <nospeech_sec> <max_sec>
"""
import array
import collections
import math
import os
import subprocess
import sys
import time

wav, pidfile = sys.argv[1], sys.argv[2]
silence_sec, nospeech_sec, max_sec = (float(x) for x in sys.argv[3:6])

RATE = 16000
CHUNK = RATE // 10 * 2          # 100 ms of s16 mono, in bytes
SKIP = 44 + RATE // 10 * 3 * 2  # WAV header + 300 ms start-up click
# Measured on this mic: quiet room RMS ~10-30, soft speech ~40-90, normal speech 100-300.
# voice = RMS above clamp(FACTOR x noise floor, MIN_VOICE, MAX_VOICE); noise floor = quietest
# 100 ms of the last FLOOR_WIN chunks. The upper clamp keeps long continuous speech from
# ever lifting the threshold above soft speech.
MIN_VOICE = 35
MAX_VOICE = 60
FACTOR = 2.5
FLOOR_WIN = 100                 # 10 s

state_dir = os.path.dirname(pidfile)


def recording():
    try:
        os.kill(int(open(pidfile).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def finish(action):
    subprocess.Popen(["npu-dictate", action], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)


start = time.monotonic()
pos = SKIP
recent = collections.deque([20.0], maxlen=FLOOR_WIN)
heard = False
last_voice = None
buf = b""

while True:
    time.sleep(0.2)
    if not recording():
        sys.exit(0)
    now = time.monotonic()
    try:
        with open(wav, "rb") as f:
            f.seek(pos)
            data = f.read()
    except OSError:
        data = b""
    pos += len(data)
    buf += data
    while len(buf) >= CHUNK:
        a = array.array("h")
        a.frombytes(buf[:CHUNK])
        buf = buf[CHUNK:]
        rms = math.sqrt(sum(x * x for x in a) / len(a))
        recent.append(rms)
        threshold = min(MAX_VOICE, max(MIN_VOICE, min(recent) * FACTOR))
        if rms > threshold:
            if not heard:
                open(os.path.join(state_dir, "speech"), "w").close()
            heard = True
            last_voice = now

    elapsed = now - start
    if elapsed >= max_sec:
        finish("stop")
    if heard and now - last_voice >= silence_sec:
        finish("stop")
    if not heard and elapsed >= nospeech_sec:
        finish("cancel")
