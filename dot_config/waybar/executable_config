{
  "layer": "top",
    "modules-left": ["custom/launcher","cpu","memory","tray"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates","pulseaudio","network","bluetooth","custom/power"],

    "pulseaudio": {
      "format": "{icon}",
      "format-muted": " ",

      "format-icons": {
        "headphone": " ",
        "default": [" ", " ", " "]
      },

      "scroll-step": 5,

      "tooltip-format": "Volume {volume}%",
      "on-click": "kitty -e wiremix",
      "on-click-right": "pamixer -t"
    },

    "network": {
      "format-wifi": "  {essid}",
      "format-ethernet": "{ifname}  ",
      "format-disconnected": "",
      "tooltip-format": "{ipaddr}",
      "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format-ethernet": "<span>{ipaddr}</span>\n<span>{netmask}/{cidr}</span>",
      "tooltip-format-disconnected": "Disconnected",
    },
    "bluetooth": {
      "format": "  ",
      "format-disabled": " 󰂲 ",
      "format-off": " 󰂲 ",
      "format-connected": " 󰂱 ",
      "format-no-controller": "",
      "tooltip-format": "Devices: {num_connections}",
      "on-click": "kitty -e bluetui"
    },
    "clock": {
      "format": "{:L%A %H:%M}",
      "format-alt": "{:L%d %B W%V %Y}",
      "tooltip": false
    },
    "cpu": {
      "interval": 15,
      "format": "   {}%",
      "max-length": 15,
      "on-click": "kitty -e btop"
    },
    "memory": {
      "interval": 30,
      "format": "   {}%",
      "max-length": 10,
      "on-click": "kitty -e btop"
    },
    "custom/launcher":{
      "format": " ",
      "on-click": "rofi -show drun -show-icons",
      "on-click-right": "killall rofi"
    },
    "custom/power": {
      "format": " ",
      "tooltip": "Power",
      "on-click": "~/.local/bin/powermenu.sh"
    },
    "custom/updates":{
      "format": "{} Update(s)",
      "exec": "checkupdates | wc -l",
      "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
      "interval": 60,
      "on-click": "kitty bash -c \"read -e -i 'sudo pacman -Syu' _; sudo pacman -Syu; exec bash\""
    }
}
